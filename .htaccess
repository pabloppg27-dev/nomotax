# URLs limpias: nomotax.io/consultoria sirve consultoria.html
Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On

# www.nomotax.io → nomotax.io (una sola versión para Google)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Archivo interno del despliegue: no se sirve
RewriteRule (^|/)\.ftp-deploy-sync-state\.json$ - [F,L]

# Barra final: /holding/ → /holding (301). Las carpetas reales, como /en/, se quedan igual
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Enlaces antiguos con .html → versión limpia (301)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /consultoria → consultoria.html (si existe)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
